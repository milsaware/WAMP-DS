<Window x:Class="WAMP_DS.Uninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WAMP-DS Uninstaller"
        Width="650"
        Height="430"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="Assets/WAMP-DS.ico">

    <Window.Resources>

        <Style TargetType="Button">

            <Setter Property="Background"
                    Value="#252526"/>

            <Setter Property="Foreground"
                    Value="#CCCCCC"/>

            <Setter Property="BorderBrush"
                    Value="#3F3F46"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Padding"
                    Value="12,5"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#37373D"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#007ACC"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#007ACC"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style TargetType="CheckBox">

            <Setter Property="Foreground"
                    Value="#CCCCCC"/>

            <Setter Property="FontSize"
                    Value="13"/>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="45"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="55"/>

        </Grid.RowDefinitions>


        <!-- Top Bar -->

        <Border Grid.Row="0"
                Background="#252526">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <Image Grid.Column="0"
                       Source="Assets/WAMP-DS.ico"
                       Width="24"
                       Height="24"
                       Margin="15,0,8,0"
                       VerticalAlignment="Center"/>


                <TextBlock Grid.Column="1"
                           Text="WAMP-DS Uninstaller"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>


        <!-- Main Content -->

        <Grid Grid.Row="1"
              Margin="35,25">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <StackPanel Grid.Row="0">

                <TextBlock Text="Uninstall WAMP-DS"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"/>

                <TextBlock Text="This will remove WAMP-DS and its installed components. Your projects will not be affected."
                   Foreground="#CCCCCC"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="0,8,0,15"/>

            </StackPanel>


            <!-- Console -->

            <Border Grid.Row="1"
                    Margin="0,15,0,0"
                    Background="#181818"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    CornerRadius="3">

                <ScrollViewer x:Name="OutputScrollViewer"
                              VerticalScrollBarVisibility="Auto">

                    <TextBox x:Name="OutputTextBox"
                             Background="Transparent"
                             Foreground="#D4D4D4"
                             BorderThickness="0"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             TextWrapping="Wrap"
                             Padding="10"
                             FontFamily="Consolas"
                             FontSize="13"/>

                </ScrollViewer>

            </Border>

        </Grid>


        <!-- Bottom Bar -->

        <Border Grid.Row="2"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="15,0">

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="100"
                        Height="34"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="UninstallButton"
                        Content="Uninstall"
                        Width="100"
                        Height="34"
                        Background="#007ACC"
                        Foreground="White"
                        BorderBrush="#007ACC"
                        Click="UninstallButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>