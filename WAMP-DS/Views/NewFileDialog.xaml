<Window x:Class="WAMP_DS.Views.NewFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New File"
        Width="400"
        Height="500"
        MinWidth="400"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">

            <TextBlock Text="Create New File"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Select the type of file you want to create."
                       Foreground="#999999"
                       FontSize="12"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- File Types -->
        <ListBox x:Name="FileTypeListBox"
                 Grid.Row="1"
                 Background="#252526"
                 BorderBrush="#3F3F46"
                 Foreground="#CCCCCC"
                 SelectionChanged="FileTypeListBox_SelectionChanged"
                 MouseDoubleClick="FileTypeListBox_MouseDoubleClick">

            <ListBoxItem Tag="">
                <StackPanel Orientation="Horizontal"
                            Margin="5">

                    <TextBlock Text="📄"
                               FontSize="18"
                               Width="35"/>

                    <StackPanel>

                        <TextBlock Text="Empty File"
                                   FontSize="13"/>

                        <TextBlock Text="Create a blank file"
                                   Foreground="#888888"
                                   FontSize="11"/>

                    </StackPanel>

                </StackPanel>
            </ListBoxItem>


            <ListBoxItem Tag=".php">
                <StackPanel Orientation="Horizontal"
                            Margin="5">

                    <TextBlock Text="🐘"
                               FontSize="18"
                               Width="35"/>

                    <StackPanel>

                        <TextBlock Text="PHP File"
                                   FontSize="13"/>

                        <TextBlock Text="PHP source file"
                                   Foreground="#888888"
                                   FontSize="11"/>

                    </StackPanel>

                </StackPanel>
            </ListBoxItem>


            <ListBoxItem Tag=".html">
                <StackPanel Orientation="Horizontal"
                            Margin="5">

                    <TextBlock Text="🌐"
                               FontSize="18"
                               Width="35"/>

                    <StackPanel>

                        <TextBlock Text="HTML File"
                                   FontSize="13"/>

                        <TextBlock Text="HTML document"
                                   Foreground="#888888"
                                   FontSize="11"/>

                    </StackPanel>

                </StackPanel>
            </ListBoxItem>


            <ListBoxItem Tag=".css">
                <StackPanel Orientation="Horizontal"
                            Margin="5">

                    <TextBlock Text="🎨"
                               FontSize="18"
                               Width="35"/>

                    <StackPanel>

                        <TextBlock Text="CSS File"
                                   FontSize="13"/>

                        <TextBlock Text="Cascading Style Sheet"
                                   Foreground="#888888"
                                   FontSize="11"/>

                    </StackPanel>

                </StackPanel>
            </ListBoxItem>


            <ListBoxItem Tag=".js">
                <StackPanel Orientation="Horizontal"
                            Margin="5">

                    <TextBlock Text="📜"
                               FontSize="18"
                               Width="35"/>

                    <StackPanel>

                        <TextBlock Text="JavaScript File"
                                   FontSize="13"/>

                        <TextBlock Text="JavaScript source file"
                                   Foreground="#888888"
                                   FontSize="11"/>

                    </StackPanel>

                </StackPanel>
            </ListBoxItem>


            <ListBoxItem Tag=".json">
                <StackPanel Orientation="Horizontal"
                            Margin="5">

                    <TextBlock Text="🧩"
                               FontSize="18"
                               Width="35"/>

                    <StackPanel>

                        <TextBlock Text="JSON File"
                                   FontSize="13"/>

                        <TextBlock Text="JavaScript Object Notation"
                                   Foreground="#888888"
                                   FontSize="11"/>

                    </StackPanel>

                </StackPanel>
            </ListBoxItem>


            <ListBoxItem Tag=".xml">
                <StackPanel Orientation="Horizontal"
                            Margin="5">

                    <TextBlock Text="🗂️"
                               FontSize="18"
                               Width="35"/>

                    <StackPanel>

                        <TextBlock Text="XML File"
                                   FontSize="13"/>

                        <TextBlock Text="Extensible Markup Language"
                                   Foreground="#888888"
                                   FontSize="11"/>

                    </StackPanel>

                </StackPanel>
            </ListBoxItem>


            <ListBoxItem Tag=".sql">
                <StackPanel Orientation="Horizontal"
                            Margin="5">

                    <TextBlock Text="🗄️"
                               FontSize="18"
                               Width="35"/>

                    <StackPanel>

                        <TextBlock Text="SQL File"
                                   FontSize="13"/>

                        <TextBlock Text="SQL database script"
                                   Foreground="#888888"
                                   FontSize="11"/>

                    </StackPanel>

                </StackPanel>
            </ListBoxItem>


            <ListBoxItem Tag=".cs">
                <StackPanel Orientation="Horizontal"
                            Margin="5">

                    <TextBlock Text="🔷"
                               FontSize="18"
                               Width="35"/>

                    <StackPanel>

                        <TextBlock Text="C# File"
                                   FontSize="13"/>

                        <TextBlock Text="C# source file"
                                   Foreground="#888888"
                                   FontSize="11"/>

                    </StackPanel>

                </StackPanel>
            </ListBoxItem>

        </ListBox>


        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Cancel"
                    Width="80"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button x:Name="CreateButton"
                    Content="Create"
                    Width="80"
                    Height="30"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="CreateButton_Click"/>

        </StackPanel>

    </Grid>

</Window>