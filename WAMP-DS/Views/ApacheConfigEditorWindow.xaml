<Window x:Class="WAMP_DS.Views.ApacheConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration Editor"
        Width="900"
        Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Editor Title -->
        <TextBlock x:Name="EditorTitleText"
                   Grid.Row="0"
                   Text="Configuration Editor"
                   Foreground="#CCCCCC"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>


        <!-- Configuration Editor -->
        <TextBox x:Name="ConfigEditor"
                 Grid.Row="1"
                 Background="#1E1E1E"
                 Foreground="#CCCCCC"
                 BorderBrush="#3F3F46"
                 BorderThickness="1"
                 FontFamily="Consolas"
                 FontSize="13"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>


        <!-- Actions -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Validate"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="ValidateButton_Click"/>

            <Button Content="Save"
                    Width="100"
                    Height="30"
                    Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>

</Window>