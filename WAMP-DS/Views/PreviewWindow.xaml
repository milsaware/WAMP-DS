<Window x:Class="WAMP_DS.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Preview"
        Width="1000"
        Height="700"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Preview Toolbar -->
        <Border Grid.Row="0"
        Background="#252526">

            <DockPanel VerticalAlignment="Center">

                <Button x:Name="RefreshButton"
                        DockPanel.Dock="Left"
                        Content="↻"
                        Width="35"
                        Height="30"
                        Margin="5,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#CCCCCC"
                        FontSize="18"
                        ToolTip="Refresh"
                        Click="RefreshButton_Click"/>


                <TextBox x:Name="UrlTextBox"
                     Height="28"
                     Margin="5,0,10,0"
                     VerticalContentAlignment="Center"
                     Background="#1E1E1E"
                     Foreground="#CCCCCC"
                     BorderBrush="#3F3F46"
                     KeyDown="UrlTextBox_KeyDown"/>

            </DockPanel>

        </Border>

        <!-- Browser -->
        <Grid Grid.Row="1">

            <wv2:WebView2 x:Name="Browser"/>


            <Border x:Name="LoadingOverlay"
            Background="#AA000000"
            Visibility="Collapsed">

                <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                    <TextBlock
                Text="Loading preview..."
                Foreground="White"
                FontSize="18"
                HorizontalAlignment="Center"/>

                    <TextBlock
                Text="Please wait"
                Foreground="#CCCCCC"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>