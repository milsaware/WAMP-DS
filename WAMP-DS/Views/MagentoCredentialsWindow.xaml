<Window x:Class="WAMP_DS.Views.MagentoCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magento Credentials"
        Width="500"
        Height="350"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Magento Authentication"
                Foreground="#CCCCCC"
                FontSize="20"
                FontWeight="SemiBold"/>

            <TextBlock Text="Magento requires Marketplace access keys to download packages."
                Foreground="#888888"
                Margin="0,8,0,20"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Public Key"
                Foreground="#CCCCCC"/>

            <TextBox x:Name="PublicKeyTextBox"
                Height="36"
                Margin="0,5,0,15"
                Background="#1E1E1E"
                Foreground="#CCCCCC"
                BorderBrush="#3F3F46"
                Padding="8"/>

            <TextBlock Text="Private Key"
                Foreground="#CCCCCC"/>

            <PasswordBox x:Name="PrivateKeyTextBox"
                Height="36"
                Margin="0,5,0,0"
                Background="#1E1E1E"
                Foreground="#CCCCCC"
                BorderBrush="#3F3F46"
                Padding="8"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0">

            <Button Content="Cancel"
                Width="90"
                Height="32"
                Margin="0,0,10,0"
                Click="CancelButton_Click"/>

            <Button Content="Save"
                Width="90"
                Height="32"
                Background="#007ACC"
                Foreground="White"
                Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>