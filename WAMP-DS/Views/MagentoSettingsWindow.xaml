<Window x:Class="WAMP_DS.Views.MagentoSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Magento Installation Settings"
    Width="890"
    Height="520"
    WindowStartupLocation="CenterOwner"
    Background="#1E1E1E">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555555"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555555"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#555555"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>

                            <ToggleButton
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">

                                <ContentPresenter
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </ToggleButton>

                            <Popup
                                Placement="Bottom"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True">

                                <Border
                                    Background="#333333"
                                    BorderBrush="#555555"
                                    BorderThickness="1">

                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Padding" Value="8,5"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
            Text="Magento Administrator"
            Foreground="#CCCCCC"
            FontSize="20"
            FontWeight="SemiBold"
            Margin="0,0,0,25"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Admin Username"/>
                <TextBox x:Name="AdminUsernameTextBox"
                    Margin="0,5,0,15"/>

                <TextBlock Text="Admin Password"/>
                <PasswordBox x:Name="AdminPasswordBox"
                    Margin="0,5,0,15"/>

                <TextBlock Text="Admin Email"/>
                <TextBox x:Name="AdminEmailTextBox"
                    Margin="0,5,0,15"/>

                <TextBlock Text="Admin First Name"/>
                <TextBox x:Name="AdminFirstNameTextBox"
                    Margin="0,5,0,15"/>

                <TextBlock Text="Admin Last Name"/>
                <TextBox x:Name="AdminLastNameTextBox"
                    Margin="0,5,0,15"/>
            </StackPanel>

            <!-- RIGHT COLUMN -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Language"/>

                <ComboBox x:Name="LanguageComboBox"
                    Margin="0,5,0,15"
                    DisplayMemberPath="Name"/>

                <TextBlock Text="Time Zone"/>

                <ComboBox x:Name="TimeZoneComboBox"
                    Margin="0,5,0,15"
                    DisplayMemberPath="Name"/>

                <TextBlock Text="Currency"/>

                <ComboBox x:Name="CurrencyComboBox"
                    Margin="0,5,0,15"
                    DisplayMemberPath="Name"/>

                <TextBlock Text="Admin URL"/>

                <TextBox x:Name="AdminUrlTextBox"
                    Margin="0,5,0,15"/>
            </StackPanel>
        </Grid>

        <Button Grid.Row="2"
            Content="Install Magento"
            Height="35"
            Width="150"
            HorizontalAlignment="Right"
            Background="#333333"
            Foreground="#CCCCCC"
            Click="InstallButton_Click"/>
    </Grid>
</Window>