<Window x:Class="WAMP_DS.Views.PhpSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PHP Settings"
        Width="950"
        Height="650"
        MinWidth="750"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Window.Resources>

        <Style x:Key="DarkComboBox"
           TargetType="ComboBox">

            <Setter Property="IsEditable"
                Value="False"/>
            
            <Setter Property="Foreground"
                Value="White"/>

            <Setter Property="Background"
                Value="#2D2D30"/>

            <Setter Property="BorderBrush"
                Value="#505050"/>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">

                        <Setter Property="Foreground"
                    Value="White"/>

                        <Setter Property="Background"
                    Value="#1E1E1E"/>

                        <Setter Property="Padding"
                    Value="6,3"/>

                        <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

                        <Style.Triggers>

                            <Trigger Property="IsHighlighted"
                         Value="True">

                                <Setter Property="Background"
                            Value="#3E3E42"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                         Value="True">

                                <Setter Property="Background"
                            Value="#007ACC"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="Padding"
                Value="0"/>


            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <ToggleButton
                            x:Name="ToggleButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}"
                            IsChecked="{Binding IsDropDownOpen,
                                                Mode=TwoWay,
                                                RelativeSource={RelativeSource TemplatedParent}}">


                                <ContentPresenter
    HorizontalAlignment="Left"
    VerticalAlignment="Center"
    Margin="6"
    Content="{TemplateBinding SelectionBoxItem}"/>

                            </ToggleButton>


                            <Popup
                            x:Name="Popup"
                            Placement="Bottom"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            AllowsTransparency="True">


                                <Border
    Background="#1E1E1E"
    BorderBrush="#505050"
    BorderThickness="1"
    Padding="0">

                                    <ScrollViewer>

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>


                            </Popup>

                        </Grid>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsDropDownOpen"
                                 Value="True">

                                <Setter TargetName="ToggleButton"
                                    Property="BorderBrush"
                                    Value="#007ACC"/>

                            </Trigger>

                        </ControlTemplate.Triggers>


                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ====================================================== -->
        <!-- HEADER -->
        <!-- ====================================================== -->

        <Border Grid.Row="0"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1"
                Padding="20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <StackPanel>

                    <TextBlock Text="PHP Configuration"
                               Foreground="#CCCCCC"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Configure the PHP runtime and php.ini settings used by WAMP-DS."
                               Foreground="#888888"
                               FontSize="12"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <!-- Search -->

                <Border Grid.Column="1"
                        Width="250"
                        Height="32"
                        Background="#1E1E1E"
                        BorderBrush="#444444"
                        BorderThickness="1"
                        CornerRadius="3">

                    <Grid>

                        <TextBox x:Name="SearchTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#CCCCCC"
                                 FontSize="12"
                                 Padding="10,7"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchTextBox_TextChanged"/>

                        <TextBlock Text="Search settings..."
                                   Foreground="#666666"
                                   FontSize="12"
                                   Margin="10,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                    </Grid>

                </Border>

            </Grid>

        </Border>


        <!-- ====================================================== -->
        <!-- MAIN CONTENT -->
        <!-- ====================================================== -->

        <Grid Grid.Row="1"
              Margin="15">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="210"/>

                <ColumnDefinition Width="15"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================== -->
            <!-- CATEGORY LIST -->
            <!-- ================================================== -->

            <Border Grid.Column="0"
                    Background="#252526"
                    BorderBrush="#3F3F46"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <TextBlock Text="PHP.INI SECTIONS"
                               Foreground="#888888"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="15,15,15,10"/>


                    <ListBox x:Name="SectionListBox"
         Grid.Row="1"
         Background="Transparent"
         BorderThickness="0"
         Foreground="#CCCCCC"
         SelectionChanged="SectionListBox_SelectionChanged"/>

                </Grid>

            </Border>


            <!-- ================================================== -->
            <!-- SETTINGS -->
            <!-- ================================================== -->

            <Border Grid.Column="2"
                    Background="#252526"
                    BorderBrush="#3F3F46"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- Section header -->

                    <Border Grid.Row="0"
                            Background="#2D2D30"
                            Padding="15">

                        <StackPanel>

                            <TextBlock x:Name="SectionTitleText"
                                       Text="PHP"
                                       Foreground="#CCCCCC"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="SectionDescriptionText"
                                       Text="PHP runtime configuration."
                                       Foreground="#888888"
                                       FontSize="12"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- Settings list -->

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel x:Name="SettingsPanel"
            Margin="15">

                            <TextBlock x:Name="NoSettingsText"
               Text="No settings found."
               Foreground="#666666"
               FontSize="13"
               HorizontalAlignment="Center"
               Margin="20"
               Visibility="Collapsed"/>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>


        <!-- ====================================================== -->
        <!-- FOOTER -->
        <!-- ====================================================== -->

        <Border Grid.Row="2"
        Background="#252526"
        BorderBrush="#3F3F46"
        BorderThickness="0,1,0,0"
        Padding="15">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="php.ini"
                       Foreground="#888888"
                       FontSize="11"
                       VerticalAlignment="Center"/>

                    <TextBlock x:Name="PhpIniPathText"
                       Text="..."
                       Foreground="#666666"
                       FontSize="11"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"/>

                </StackPanel>


                <Button Grid.Column="1"
                Content="Save Changes"
                Width="110"
                Height="30"
                Background="#007ACC"
                BorderBrush="#007ACC"
                Foreground="White"
                Click="SaveButton_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>