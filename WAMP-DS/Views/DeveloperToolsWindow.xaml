<Window x:Class="WAMP_DS.Views.DeveloperToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Developer Tools"
        Width="800"
        Height="500"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Left">


            <Button x:Name="TestRewriteButton"
                    Content="Test Apache Rewrite Module"
                    Width="220"
                    Height="30"
                    Margin="0,0,10,10"
                    Background="#333333"
                    BorderBrush="#555555"
                    Foreground="#CCCCCC"
                    Click="TestRewriteButton_Click"/>


            <Button x:Name="TestMagentoContactPatchButton"
                    Content="Test Magento Contact Patch"
                    Width="220"
                    Height="30"
                    Margin="0,0,10,10"
                    Background="#333333"
                    BorderBrush="#555555"
                    Foreground="#CCCCCC"
                    Click="TestMagentoContactPatchButton_Click"/>


            <Button x:Name="TestMagentoSourceMapPatchButton"
                    Content="Test Source Map Patch"
                    Width="220"
                    Height="30"
                    Margin="0,0,10,10"
                    Background="#333333"
                    BorderBrush="#555555"
                    Foreground="#CCCCCC"
                    Click="TestMagentoSourceMapPatchButton_Click"/>


            <Button x:Name="TestMagentoStaticResourcePatchButton"
                    Content="Test StaticResource Patch"
                    Width="220"
                    Height="30"
                    Margin="0,0,10,10"
                    Background="#333333"
                    BorderBrush="#555555"
                    Foreground="#CCCCCC"
                    Click="TestMagentoStaticResourcePatchButton_Click"/>

            <Button x:Name="TestMagentoGeneratedFixButton"
                Content="Delete Magento Generated Folder"
                Width="220"
                Height="30"
                Margin="0,0,10,10"
                Background="#333333"
                BorderBrush="#555555"
                Foreground="#CCCCCC"
                Click="TestMagentoGeneratedFixButton_Click"/>


        </StackPanel>


        <TextBox x:Name="ReportBox"
                 Grid.Row="1"
                 Margin="0,15,0,0"
                 Background="#252526"
                 Foreground="#CCCCCC"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 FontSize="13"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>


    </Grid>

</Window>