<Window x:Class="WAMP_DS.Views.ApacheSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apache Modules"
        Width="400"
        Height="570"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Grid Margin="25">

        <StackPanel>

            <TextBlock Text="Apache Modules"
                       Foreground="#CCCCCC"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>


            <!-- General Settings -->
            <Border Background="#252526"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    Padding="15"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="General"
                               Foreground="#888888"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>


                    <CheckBox x:Name="HttpEnabledCheckBox"
                              Content="Enable HTTP (Port 80)"
                              Foreground="#CCCCCC"
                              Margin="0,5"
                              Checked="SettingChanged"
                              Unchecked="SettingChanged"/>


                    <CheckBox x:Name="HttpsEnabledCheckBox"
                              Content="Enable HTTPS / SSL (Port 443)"
                              Foreground="#CCCCCC"
                              Margin="0,5"
                              Checked="SettingChanged"
                              Unchecked="SettingChanged"/>

                </StackPanel>

            </Border>


            <!-- Modules -->
            <Border Background="#252526"
        BorderBrush="#3F3F46"
        BorderThickness="1"
        Padding="15"
        Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="Apache Modules"
                   Foreground="#888888"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>


                    <ScrollViewer Height="250">

                        <ItemsControl ItemsSource="{Binding Modules}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <CheckBox
                            Content="{Binding Name}"
                            IsChecked="{Binding IsEnabled}"
                            Checked="ModuleCheckBox_Changed"
                            Unchecked="ModuleCheckBox_Changed"
                            Foreground="#CCCCCC"
                            Margin="0,5"/>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>

</Window>