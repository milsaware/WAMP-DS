<Window x:Class="WAMP_DS.Views.ApacheVhostsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apache Virtual Hosts"
        Width="660"
        Height="650"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">


    <Window.Resources>

        <Style x:Key="DarkComboBox"
               TargetType="ComboBox">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#2D2D30"/>

            <Setter Property="BorderBrush"
                    Value="#505050"/>

            <Setter Property="Padding"
                    Value="0"/>


            <Setter Property="ItemContainerStyle">

                <Setter.Value>

                    <Style TargetType="ComboBoxItem">

                        <Setter Property="Foreground"
                                Value="White"/>

                        <Setter Property="Background"
                                Value="#1E1E1E"/>

                        <Setter Property="Padding"
                                Value="8,5"/>


                        <Style.Triggers>

                            <Trigger Property="IsHighlighted"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#3E3E42"/>

                            </Trigger>


                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#007ACC"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </Setter.Value>

            </Setter>


            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <ToggleButton x:Name="ToggleButton"

                                          Background="{TemplateBinding Background}"

                                          BorderBrush="{TemplateBinding BorderBrush}"

                                          Foreground="{TemplateBinding Foreground}"

                                          IsChecked="{Binding IsDropDownOpen,
                                          RelativeSource={RelativeSource TemplatedParent}}">


                                <ContentPresenter

                                    Margin="8"

                                    HorizontalAlignment="Left"

                                    VerticalAlignment="Center"

                                    Content="{TemplateBinding SelectionBoxItem}"/>

                            </ToggleButton>


                            <Popup x:Name="Popup"

                                   Placement="Bottom"

                                   AllowsTransparency="True"

                                   IsOpen="{TemplateBinding IsDropDownOpen}">


                                <Border Background="#1E1E1E"

                                        BorderBrush="#505050"

                                        BorderThickness="1">


                                    <ScrollViewer>

                                        <ItemsPresenter/>

                                    </ScrollViewer>


                                </Border>


                            </Popup>


                        </Grid>


                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>



    <Grid Margin="20">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="220"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>



        <!-- HOST LIST -->

        <Border Grid.Column="0"

                Background="#252526"

                BorderBrush="#3F3F46"

                BorderThickness="1"

                Padding="10">


            <DockPanel>


                <Button DockPanel.Dock="Bottom"

                        Content="Add Host"

                        Height="32"

                        Margin="0,10,0,0"

                        Background="#333333"

                        BorderBrush="#555555"

                        Foreground="#CCCCCC"

                        Click="AddHostButton_Click"/>



                <ListBox x:Name="VirtualHostsList"

                         Background="#1E1E1E"

                         Foreground="#CCCCCC"

                         BorderThickness="0"

                         SelectionChanged="VirtualHostsList_SelectionChanged"/>


            </DockPanel>


        </Border>





        <!-- EDITOR -->

        <Border Grid.Column="1"

                Margin="20,0,0,0"

                Background="#252526"

                BorderBrush="#3F3F46"

                BorderThickness="1"

                Padding="20">


            <ScrollViewer VerticalScrollBarVisibility="Auto">


                <StackPanel>


                    <TextBlock Text="Virtual Host"

                               Foreground="#CCCCCC"

                               FontSize="20"

                               FontWeight="SemiBold"

                               Margin="0,0,0,20"/>



                    <TextBlock Text="Server Name"

                               Foreground="#888888"/>

                    <TextBox x:Name="ServerNameText"

                             Margin="0,5,0,15"

                             Background="#1E1E1E"

                             Foreground="#CCCCCC"/>



                    <TextBlock Text="Document Root"

                               Foreground="#888888"/>

                    <TextBox x:Name="DocumentRootText"

                             Margin="0,5,0,15"

                             Background="#1E1E1E"

                             Foreground="#CCCCCC"/>



                    <TextBlock Text="Directory"

                               Foreground="#888888"/>

                    <TextBox x:Name="DirectoryText"

                             Margin="0,5,0,15"

                             Background="#1E1E1E"

                             Foreground="#CCCCCC"/>



                    <!-- SSL -->

                    <TextBlock Text="SSL"

                               Foreground="#888888"

                               FontSize="11"

                               FontWeight="SemiBold"

                               Margin="0,10,0,10"/>


                    <Border Background="#1E1E1E"

                            BorderBrush="#3F3F46"

                            BorderThickness="1"

                            Padding="10"

                            Margin="0,0,0,10">


                        <StackPanel>


                            <CheckBox x:Name="HttpsEnabledCheckBox"

                                      Content="Enable HTTPS"

                                      Foreground="#CCCCCC"

                                      Margin="0,3"/>


                        </StackPanel>


                    </Border>





                    <TextBlock Text="Directory Rules"

                               Foreground="#888888"

                               FontSize="11"

                               FontWeight="SemiBold"

                               Margin="0,10,0,10"/>



                    <TextBlock Text="Allow Override"

                               Foreground="#888888"/>


                    <ComboBox x:Name="AllowOverrideComboBox"

                              Style="{StaticResource DarkComboBox}"

                              Height="40"

                              Margin="0,5,0,10"

                              SelectedValuePath="Content">


                        <ComboBoxItem Content="None"/>

                        <ComboBoxItem Content="All"/>

                        <ComboBoxItem Content="AuthConfig"/>

                        <ComboBoxItem Content="FileInfo"/>

                        <ComboBoxItem Content="Indexes"/>

                        <ComboBoxItem Content="Limit"/>

                        <ComboBoxItem Content="Options"/>

                        <ComboBoxItem Content="Nonfatal"/>


                    </ComboBox>





                    <TextBlock Text="Require"

                               Foreground="#888888"/>


                    <ComboBox x:Name="RequireComboBox"

                              Style="{StaticResource DarkComboBox}"

                              Height="40"

                              Margin="0,5,0,10"

                              SelectedValuePath="Content">


                        <ComboBoxItem Content="None"/>

                        <ComboBoxItem Content="all granted"/>

                        <ComboBoxItem Content="all denied"/>

                        <ComboBoxItem Content="local"/>

                        <ComboBoxItem Content="valid-user"/>


                    </ComboBox>





                    <TextBlock Text="Options"

                               Foreground="#888888"

                               Margin="0,10,0,5"/>


                    <Border Background="#1E1E1E"

                            BorderBrush="#3F3F46"

                            BorderThickness="1"

                            Padding="10"

                            Margin="0,0,0,10">


                        <StackPanel>


                            <CheckBox x:Name="OptionsIndexesCheckBox"

                                      Content="Indexes"

                                      Foreground="#CCCCCC"

                                      Margin="0,3"/>


                            <CheckBox x:Name="OptionsFollowSymLinksCheckBox"

                                      Content="FollowSymLinks"

                                      Foreground="#CCCCCC"

                                      Margin="0,3"/>


                            <CheckBox x:Name="OptionsExecCGICheckBox"

                                      Content="ExecCGI"

                                      Foreground="#CCCCCC"

                                      Margin="0,3"/>


                            <CheckBox x:Name="OptionsIncludesCheckBox"

                                      Content="Includes"

                                      Foreground="#CCCCCC"

                                      Margin="0,3"/>


                            <CheckBox x:Name="OptionsMultiViewsCheckBox"

                                      Content="MultiViews"

                                      Foreground="#CCCCCC"

                                      Margin="0,3"/>


                        </StackPanel>


                    </Border>



                    <CheckBox x:Name="RewriteEngineCheckBox"

                              Content="Rewrite Engine On"

                              Foreground="#CCCCCC"

                              Margin="0,5"/>





                    <TextBlock Text="Error Log"

                               Foreground="#888888"

                               Margin="0,15,0,0"/>


                    <TextBox x:Name="ErrorLogText"

                             Margin="0,5,0,15"

                             Background="#1E1E1E"

                             Foreground="#CCCCCC"/>





                    <TextBlock Text="Custom Log"

                               Foreground="#888888"/>


                    <TextBox x:Name="CustomLogText"

                             Margin="0,5,0,15"

                             Background="#1E1E1E"

                             Foreground="#CCCCCC"/>





                    <StackPanel Orientation="Horizontal"

                                HorizontalAlignment="Right">


                        <Button Content="Remove"

                                Width="100"

                                Height="30"

                                Margin="0,10,10,0"

                                Background="#333333"

                                BorderBrush="#555555"

                                Foreground="#CCCCCC"

                                Click="RemoveHostButton_Click"/>



                        <Button Content="Save"

                                Width="100"

                                Height="30"

                                Margin="0,10,0,0"

                                Background="#333333"

                                BorderBrush="#555555"

                                Foreground="#CCCCCC"

                                Click="SaveButton_Click"/>


                    </StackPanel>


                </StackPanel>


            </ScrollViewer>


        </Border>


    </Grid>


</Window>