<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WAMP_DS.Installer</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>WAMP-DS.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Templates\Apache\httpd-ssl.conf" />
    <None Remove="Templates\Apache\httpd.conf" />
    <None Remove="Templates\OpenSearch\opensearch.yml" />
    <None Remove="Templates\phpMyAdmin\config.inc.php" />
    <None Remove="Templates\PHP\php.ini" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="WAMP-DS.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\Apache\httpd.conf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\Apache\httpd-ssl.conf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Templates\OpenSearch\opensearch.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Templates\phpMyAdmin\config.inc.php">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Templates\PHP\php.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>
