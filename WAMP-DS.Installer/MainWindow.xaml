<Window x:Class="WAMP_DS.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WAMP_DS.Installer"
        mc:Ignorable="d"
        Title="WAMP-DS Installer"
        Height="450"
        Width="700"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>

        <!-- Welcome Page -->
        <Grid x:Name="WelcomePage"
          Margin="40">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                    VerticalAlignment="Center">

                <TextBlock Text="WAMP-DS"
                       FontSize="36"
                       FontWeight="Bold"/>

                <TextBlock Text="Web Application Multi-Purpose Development Sandbox"
                       FontSize="18"
                       Margin="0,5,0,30"/>

                <TextBlock Text="Welcome to the WAMP-DS installer."
                       FontSize="15"
                       Margin="0,0,0,10"/>

                <TextBlock Text="This will install WAMP-DS and its required development services."
                       FontSize="14"
                       TextWrapping="Wrap"/>

            </StackPanel>

            <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

                <Button x:Name="NextButton"
                    Content="Next"
                    Width="100"
                    Height="35"
                    Click="NextButton_Click"/>

            </StackPanel>

        </Grid>


        <!-- Installation Location Page -->
        <Grid x:Name="LocationPage"
          Margin="40"
          Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                    VerticalAlignment="Center">

                <TextBlock Text="Installation Location"
                       FontSize="28"
                       FontWeight="Bold"/>

                <TextBlock Text="Choose where WAMP-DS should be installed."
                       FontSize="15"
                       Margin="0,8,0,30"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InstallationPathTextBox"
                         Grid.Column="0"
                         Height="35"
                         VerticalContentAlignment="Center"
                         Padding="8"
                         Text="C:\WAMP-DS"/>

                    <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        Content="Browse..."
                        Width="100"
                        Height="35"
                        Margin="10,0,0,0"
                        Click="BrowseButton_Click"/>

                </Grid>

            </StackPanel>


            <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                <Button Content="Back"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="BackButton_Click"/>

                <Button Content="Next"
                    Width="100"
                    Height="35"
                    Click="LocationNextButton_Click"/>

            </StackPanel>

        </Grid>

        <!-- Installation Page -->
        <Grid x:Name="InstallationPage"
              Margin="40"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                VerticalAlignment="Center">

                <TextBlock Text="Installing WAMP-DS"
                   FontSize="28"
                   FontWeight="Bold"/>

                <Grid Margin="0,10,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- Current installation status + details button -->

                    <Grid Grid.Row="0">

                        <TextBlock x:Name="InstallationStatusText"
                   Text="Preparing installation..."
                   FontSize="15"
                   VerticalAlignment="Center"/>

                        <Button x:Name="DetailsButton"
                Content="Show Details"
                HorizontalAlignment="Right"
                Padding="10,4"
                Click="DetailsButton_Click"/>

                    </Grid>


                    <!-- Progress bar -->

                    <ProgressBar x:Name="InstallationProgressBar"
                 Grid.Row="1"
                 Height="8"
                 Minimum="0"
                 Maximum="100"
                 Value="0"
                 Margin="0,8,0,0"/>

                </Grid>

                <Border x:Name="DetailsBorder"
        Margin="0,10,0,0"
        Background="#1E1E1E"
        BorderBrush="#3F3F46"
        BorderThickness="1"
        Visibility="Collapsed">

                    <ScrollViewer Height="140"
                  VerticalScrollBarVisibility="Auto">

                        <TextBox x:Name="InstallationReportTextBox"
                 Background="Transparent"
                 Foreground="#D4D4D4"
                 BorderThickness="0"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="False"
                 TextWrapping="Wrap"
                 Padding="8"
                 FontFamily="Consolas"/>

                    </ScrollViewer>

                </Border>

            </StackPanel>

            <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                <CheckBox x:Name="LaunchWampDsCheckBox"
                    Content="Launch WAMP-DS"
                    IsChecked="True"
                    VerticalAlignment="Center"
                    Margin="0,0,15,0"
                    Visibility="Collapsed"/>

                <Button x:Name="InstallationCancelButton"
                    Content="Cancel"
                    Width="100"
                    Height="35"
                    Click="InstallationCancelButton_Click"/>

                <Button x:Name="FinishButton"
                    Content="Finish"
                    Width="100"
                    Height="35"
                    Margin="10,0,0,0"
                    Click="FinishButton_Click"
                    Visibility="Collapsed"/>

            </StackPanel>

        </Grid>

    </Grid>
</Window>
